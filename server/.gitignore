# ============================================================
# Somewhere/server — .gitignore
# ============================================================

# --- Secrets ---
.env
.env.local
.env.*.local

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*

# --- Prisma generated client (re-generated by: npx prisma db push) ---
src/generated/

# --- AI tool internal folders (not project code) ---
.agents/
.windsurf/
.claude/
skills-lock.json
prisma7.config.ts

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- Logs ---
*.log
logs/
