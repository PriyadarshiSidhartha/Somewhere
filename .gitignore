# ============================================================
# Somewhere — Root .gitignore
# ============================================================

# --- Secrets (NEVER commit these) ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Prisma generated client (re-generated by prisma db push) ---
src/generated/

# --- OS / editor junk ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# --- IDE / AI tool folders ---
.idea/
.vscode/
*.code-workspace
.agents/
.windsurf/
.claude/
skills-lock.json
prisma7.config.ts

# --- Logs ---
*.log
logs/

# --- Build output ---
dist/
build/
out/
